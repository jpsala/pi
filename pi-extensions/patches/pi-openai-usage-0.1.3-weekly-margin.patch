+type WeeklyUsageWindow = {
+  remainingPercent: number;
+  resetInSeconds: number;
+};
+
+function formatWeeklyMarginWidget(
+  snapshot: UsageSnapshot,
+  options: FormatUsageStatusLineOptions,
+): FormattedWidget | undefined {
+  const weeklyWindow = findWeeklyUsageWindow(snapshot);
+  if (weeklyWindow === undefined) return undefined;
+
+  const marginHours = calculateWeeklyMarginHours(
+    weeklyWindow.remainingPercent,
+    weeklyWindow.resetInSeconds,
+  );
+  const value = marginHours === null ? "--" : formatSignedHours(marginHours);
+  return {
+    text: formatNeutralText(`margen ${value}`, options.theme),
+    hasAvailableValue: marginHours !== null,
+  };
+}
+
+function findWeeklyUsageWindow(snapshot: UsageSnapshot): WeeklyUsageWindow | undefined {
+  const candidates = [
+    {
+      remainingPercent: snapshot.fiveHourLeftPercent,
+      resetInSeconds: snapshot.fiveHourResetInSeconds,
+      windowInSeconds: snapshot.fiveHourWindowInSeconds,
+    },
+    {
+      remainingPercent: snapshot.sevenDayLeftPercent,
+      resetInSeconds: snapshot.sevenDayResetInSeconds,
+      windowInSeconds: snapshot.sevenDayWindowInSeconds,
+    },
+  ];
+
+  const weekly = candidates.find(
+    (candidate) =>
+      candidate.windowInSeconds === WEEKLY_WINDOW_SECONDS &&
+      isFiniteNumber(candidate.remainingPercent) &&
+      isFiniteNumber(candidate.resetInSeconds),
+  );
+  if (
+    weekly === undefined ||
+    !isFiniteNumber(weekly.remainingPercent) ||
+    !isFiniteNumber(weekly.resetInSeconds)
+  ) {
+    return undefined;
+  }
+
+  return {
+    remainingPercent: weekly.remainingPercent,
+    resetInSeconds: weekly.resetInSeconds,
+  };
+}
+
+export function calculateWeeklyMarginHours(
+  remainingPercent: number,
+  resetInSeconds: number,
+): number | null {
+  const consumedPercent = 100 - clamp(remainingPercent, 0, 100);
+  const calendarHoursRemaining = clamp(resetInSeconds / 3_600, 0, WEEKLY_WINDOW_HOURS);
+  const calendarHoursElapsed = WEEKLY_WINDOW_HOURS - calendarHoursRemaining;
+  const elapsedScheduledHours =
+    DEFAULT_ACTIVE_HOURS_PER_WEEK * calendarHoursElapsed / WEEKLY_WINDOW_HOURS;
+  if (consumedPercent <= 0 || elapsedScheduledHours <= 0) return null;
+
+  const observedBurnPercentPerActiveHour = consumedPercent / elapsedScheduledHours;
+  const supportedRemainingHours = remainingPercent / observedBurnPercentPerActiveHour;
+  const plannedRemainingHours = DEFAULT_ACTIVE_HOURS_PER_WEEK - elapsedScheduledHours;
+  return supportedRemainingHours - plannedRemainingHours;
+}
+
+function formatSignedHours(hours: number): string {
+  const rounded = Math.round(hours);
+  const normalized = Object.is(rounded, -0) ? 0 : rounded;
+  return `${normalized >= 0 ? "+" : ""}${normalized}h`;
+}
